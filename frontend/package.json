    "@angular/router": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@openng/optimus-ui": "2.0.1",
    "@openng/optimus-ui-themes": "2.0.1",
    "@openng/icons": "1.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
